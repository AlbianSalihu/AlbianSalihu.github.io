---
// Skills section
// To add a link to a tag: add a url field. Leave url empty ('') for no link.
type Skill = { name: string; nameFR?: string };
type Category = {
  titleEN: string;
  titleFR: string;
  icon: string;
  skills: Skill[];
  stackSkills?: boolean;
};

const categories: Category[] = [
  {
    titleEN: 'Robotics & Control',
    titleFR: 'Robotique & Contrôle',
    icon: `<circle cx="12" cy="12" r="3"></circle><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"></path>`,
    skills: [
      { name: 'ROS 2' },
      { name: 'Real-time Control' },
      { name: 'MPC' },
      { name: 'Aerial Robotics' },
      { name: 'GNSS' },
      { name: 'Sensor Integration' },
      { name: 'System Integration' },
      { name: 'Conveyor Control' },
    ],
  },
  {
    titleEN: 'Embedded Systems',
    titleFR: 'Systèmes embarqués',
    icon: `<rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line>`,
    skills: [
      { name: 'FPGA' },
      { name: 'Vivado / Vitis' },
      { name: 'Quartus' },
      { name: 'Microcontrollers' },
      { name: 'VHDL' },
      { name: 'µC/OS (RTOS)' },
    ],
  },
  {
    titleEN: 'AI & Data',
    titleFR: 'IA & Données',
    icon: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>`,
    skills: [
      { name: 'Machine Learning' },
      { name: 'Deep Learning' },
      { name: 'Computer Vision' },
      { name: 'Model Deployment' },
      { name: 'PyTorch' },
    ],
  },
  {
    titleEN: 'Electronics & CAD',
    titleFR: 'Électronique & CAO',
    icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>`,
    skills: [
      { name: 'PCB Design' },
      { name: 'Altium Designer' },
      { name: 'Fusion 360' },
      { name: 'Catia' },
      { name: 'FreeCAD' },
      { name: 'Prototyping' },
    ],
  },
  {
    titleEN: 'Programming',
    titleFR: 'Programmation',
    icon: `<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>`,
    skills: [
      { name: 'Python' },
      { name: 'C / C++' },
      { name: 'MATLAB' },
      { name: 'C#' },
      { name: 'Java' },
    ],
  },
  {
    titleEN: 'Languages',
    titleFR: 'Langues',
    icon: `<circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>`,
    skills: [
      { name: 'French — Native',   nameFR: 'Français — Natif' },
      { name: 'Albanian — Native', nameFR: 'Albanais — Natif' },
      { name: 'English — C1',      nameFR: 'Anglais — C1' },
    ],
    stackSkills: true,
  },
];
---

<section class="skills">
  <div class="container">
    <h2 class="section-title" data-i18n="skills.title" data-reveal>Skills & Technologies</h2>
    <p class="section-subtitle glow-hover" data-i18n="skills.sub" data-reveal style="transition-delay:80ms">Tools and domains I work with</p>

    <div class="skills-grid">
      {categories.map((cat, i) => (
        <div class="skill-category" data-reveal style={`transition-delay:${i * 70}ms`}>
          <div class="category-header">
            <div class="category-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
            </div>
            <h3 class="category-title">
              <span class="lang-en">{cat.titleEN}</span>
              <span class="lang-fr">{cat.titleFR}</span>
            </h3>
          </div>
          <div class:list={['skill-list', cat.stackSkills && 'skill-list--stack']}>
            {cat.skills.map(skill => (
              <span class="skill-tag">
                {skill.nameFR ? <><span class="lang-en">{skill.name}</span><span class="lang-fr">{skill.nameFR}</span></> : skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    padding: 6rem 2rem;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-dim);
    font-size: 1.1rem;
    margin-bottom: 3rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skill-category {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem;
    transition: border-color 0.2s ease;
  }

  .skill-category:hover {
    border-color: #2a2a2a;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .category-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 0.5rem;
    color: var(--color-text-dim);
  }

  .category-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    padding: 0.375rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    font-size: 0.8rem;
    color: var(--color-text-dim);
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .skill-tag:hover {
    border-color: #3a3a3a;
    color: var(--color-text);
  }

  .skill-list--stack { flex-direction: column; align-items: flex-start; }

  .skill-tag .lang-en { display: inline; }
  .skill-tag .lang-fr { display: none; }
  :lang(fr) .skill-tag .lang-fr { display: inline; }
  :lang(fr) .skill-tag .lang-en { display: none; }

  /* Linked tags get a subtle external link indicator */
  .skill-link::after {
    content: ' ↗';
    font-size: 0.65rem;
    opacity: 0.5;
  }

  .skill-link:hover::after {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .skills {
      padding: 4rem 1.5rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
