---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="About — Albian Salihu" description="Robotics Engineer based in Lausanne, Switzerland">
  <main class="about-page">
    <div class="container">
      <h1 class="page-title" data-i18n="about.title" data-reveal>About Me</h1>

      <div class="content-grid">
        <section class="content-section intro-section" data-reveal style="transition-delay:80ms">
          <h2 data-i18n="about.bg">Background</h2>
          <p data-i18n="about.bio1">
            I'm Albian, a Robotics Engineer based in Lausanne, Switzerland. I hold a Master's degree
            in Robotics (minor in Space Technologies) and a Bachelor's in Microengineering, both from
            EPFL — one of Europe's leading engineering institutions.
          </p>
          <p data-i18n="about.bio2">
            My path started in electronics with a vocational diploma (CFC) and baccalaureate at CPLN,
            before moving into microengineering and then robotics at EPFL. That progression gives me
            a strong foundation across the full hardware-software stack — from circuit-level electronics
            to high-level control algorithms and AI.
          </p>
          <p data-i18n="about.bio3">
            I currently work at Wasteflow, where I develop real-time control systems for industrial
            waste-sorting conveyors — acting as the "muscle" that executes the decisions made by the
            company's AI system.
          </p>
        </section>

        <section class="content-section" data-reveal style="transition-delay:160ms">
          <h2 data-i18n="about.what">What I Do</h2>
          <div class="what-i-do-grid">
            <div class="service-card">
              <div class="service-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"></path>
                </svg>
              </div>
              <h3 data-i18n="about.s1t">Robotics & Control</h3>
              <p data-i18n="about.s1d">Real-time control systems, ROS 2, sensor integration, and autonomous robot platforms.</p>
            </div>
            <div class="service-card">
              <div class="service-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                  <rect x="9" y="9" width="6" height="6"></rect>
                  <line x1="9" y1="1" x2="9" y2="4"></line>
                  <line x1="15" y1="1" x2="15" y2="4"></line>
                  <line x1="9" y1="20" x2="9" y2="23"></line>
                  <line x1="15" y1="20" x2="15" y2="23"></line>
                  <line x1="20" y1="9" x2="23" y2="9"></line>
                  <line x1="20" y1="14" x2="23" y2="14"></line>
                  <line x1="1" y1="9" x2="4" y2="9"></line>
                  <line x1="1" y1="14" x2="4" y2="14"></line>
                </svg>
              </div>
              <h3 data-i18n="about.s2t">Embedded Systems & FPGA</h3>
              <p data-i18n="about.s2d">FPGA development on Xilinx Zynq and Intel DE10. Signal processing, control loops, real-time constraints.</p>
            </div>
            <div class="service-card">
              <div class="service-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                </svg>
              </div>
              <h3 data-i18n="about.s3t">AI & Machine Learning</h3>
              <p data-i18n="about.s3d">Training and deploying ML models for real-world decision-making, including computer vision pipelines.</p>
            </div>
            <div class="service-card">
              <div class="service-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
              </div>
              <h3 data-i18n="about.s4t">Electronics & Prototyping</h3>
              <p data-i18n="about.s4d">PCB design, circuit assembly, CAD modelling, and hands-on hardware prototyping from concept to test.</p>
            </div>
          </div>
        </section>

        <section class="content-section education-section" data-reveal style="transition-delay:100ms">
          <h2 data-i18n="about.edu">Education</h2>
          <div class="timeline">
            <div class="timeline-item">
              <div class="timeline-date">2021 – 2024</div>
              <div class="timeline-content">
                <h3 data-i18n="about.edu1t">Master in Robotics — Minor in Space Technologies</h3>
                <p>EPFL, École Polytechnique Fédérale de Lausanne</p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="timeline-date">2018 – 2021</div>
              <div class="timeline-content">
                <h3 data-i18n="about.edu2t">Bachelor in Microengineering</h3>
                <p>EPFL, École Polytechnique Fédérale de Lausanne</p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="timeline-date">2016 – 2017</div>
              <div class="timeline-content">
                <h3 data-i18n="about.edu3t">Federal Vocational Baccalaureate</h3>
                <p>CPLN, Centre Professionnel du Littoral Neuchâtelois</p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="timeline-date">2012 – 2016</div>
              <div class="timeline-content">
                <h3 data-i18n="about.edu4t">Federal VET Diploma (CFC) — Electronics</h3>
                <p>CPLN, Centre Professionnel du Littoral Neuchâtelois</p>
              </div>
            </div>
          </div>
        </section>

        <section class="content-section cta-section" data-reveal style="transition-delay:150ms">
          <h2 data-i18n="about.cta">Let's Work Together</h2>
          <p data-i18n="about.cta_sub">Interested in collaborating on robotics, embedded systems, or AI projects?</p>
          <div class="contact-buttons">
            <a href={`${base}/projects`} class="btn btn-primary">
              <span data-i18n="about.btn_w">View My Work</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="mailto:albian.salihu@hotmail.fr" class="btn btn-secondary" data-i18n="about.btn_c">Contact Me</a>
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .about-page {
    min-height: 100vh;
    padding: calc(var(--nav-height) + 2rem) 2rem 5rem;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-text);
  }

  .content-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .content-section {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
  }

  .content-section h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .content-section p {
    line-height: 1.7;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }

  .content-section p:last-of-type {
    margin-bottom: 0;
  }

  .what-i-do-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .service-card {
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    transition: border-color 0.2s ease;
  }

  .service-card:hover {
    border-color: #2a2a2a;
  }

  .service-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 0.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-dim);
  }

  .service-card h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .service-card p {
    font-size: 0.875rem;
    color: var(--color-text-dim);
    margin: 0;
    line-height: 1.5;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .timeline-item {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .timeline-date {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--color-text-dim);
    white-space: nowrap;
    min-width: 80px;
    padding-top: 0.2rem;
    letter-spacing: 0.02em;
  }

  .timeline-content h3 {
    font-family: var(--font-heading);
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.2rem;
  }

  .timeline-content p {
    font-size: 0.85rem;
    color: var(--color-text-dim);
    margin: 0;
  }

  .cta-section {
    text-align: center;
  }

  .cta-section p {
    margin-bottom: 1.5rem;
  }

  .contact-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    font-family: var(--font-body);
    text-decoration: none;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: #f1f5f9;
    color: #0a0a0a;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }

  .btn-primary:hover {
    background: #ffffff;
  }

  .btn-primary svg {
    transition: transform 0.2s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--color-text-dim);
  }

  @media (max-width: 768px) {
    .about-page {
      padding-top: calc(var(--nav-height) + 1rem);
    }

    .what-i-do-grid {
      grid-template-columns: 1fr;
    }

    .contact-buttons {
      flex-direction: column;
      align-items: center;
    }

    .btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }

    .timeline-item {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
