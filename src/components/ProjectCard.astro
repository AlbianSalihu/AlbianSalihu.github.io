---
interface Props {
  slug: string;
  title: string;
  description: string;
  tags?: string[] | undefined;
  featured?: boolean | undefined;
  date?: string | undefined;
  image?: string | undefined;
  imageBg?: string | undefined;
  imagePosition?: string | undefined;
  logoMode?: boolean | undefined;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { slug, title, description, tags, featured, date, image, imageBg, imagePosition, logoMode } = Astro.props;
---

<a href={`${base}/projects/${slug}`} class:list={['project-card', { featured, 'has-image': !!image }]} data-reveal>
  {image && (
    <div class="card-thumbnail" style={imageBg ? `background:${imageBg}` : undefined}>
      <img src={`${base}/${image}`} alt={title} loading="lazy"
        style={[imageBg && `background:${imageBg}`, imagePosition && `object-position:${imagePosition}`].filter(Boolean).join(';') || undefined}
        class:list={[{ 'logo-thumb': !!logoMode }]} />
    </div>
  )}
  <div class="project-card-content">
    <div class="card-top">
      {featured && <span class="featured-badge" data-i18n="proj.feat_badge">Featured</span>}
      {date && <span class="project-date">{date}</span>}
    </div>
    <h3 class="project-title" data-i18n={`p.${slug}.t`}>{title}</h3>
    <p class="project-description" data-i18n={`p.${slug}.d`}>{description}</p>
    {tags && tags.length > 0 && (
      <div class="project-tags">
        {tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
    <span class="read-more">
      <span data-i18n="proj.read_more">View project</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover {
    border-color: #2a2a2a;
    transform: translateY(-2px);
  }

  /* Thumbnail */
  .card-thumbnail {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #111;
    position: relative;
    border-radius: 1rem 1rem 0 0;
  }

  .featured .card-thumbnail {
    height: 200px;
  }

  .card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.35s ease, opacity 0.35s ease;
    opacity: 0.9;
  }

  .project-card:hover .card-thumbnail img {
    transform: scale(1.04);
    opacity: 1;
  }

  /* Logo thumbnails: contain instead of cover, centred with padding */
  .card-thumbnail img.logo-thumb {
    object-fit: contain;
    padding: 1.5rem 2rem;
  }

  .project-card:hover .card-thumbnail img.logo-thumb {
    transform: scale(1.03);
  }

  /* Gradient fade at the bottom edge so thumbnails blend into the dark card */
  .card-thumbnail::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(13,16,23,0) 50%,
      rgba(13,16,23,1) 100%
    );
    pointer-events: none;
  }

  /* Content area — flex: 1 so it fills remaining space after the thumbnail */
  .project-card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.75rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .featured-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(255,255,255,0.07);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .project-date {
    font-size: 0.75rem;
    color: var(--color-text-dim);
    font-family: var(--font-heading);
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
    color: var(--color-text);
    transition: color 0.2s ease;
    line-height: 1.3;
  }

  .project-card:hover .project-title {
    color: #ffffff;
  }

  .project-description {
    color: var(--color-text-dim);
    line-height: 1.6;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .tag {
    padding: 0.2rem 0.55rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font-size: 0.72rem;
    color: var(--color-text-dim);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-dim);
    transition: color 0.2s ease, gap 0.2s ease;
    font-family: var(--font-heading);
    letter-spacing: 0.02em;
  }

  .project-card:hover .read-more {
    color: var(--color-text);
    gap: 0.5rem;
  }
</style>
