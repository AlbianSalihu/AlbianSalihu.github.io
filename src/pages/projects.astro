---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

function projectSortKey(date: string | undefined): number {
  if (!date) return 0;
  if (/Present/i.test(date)) return 9999;
  const years = date.match(/\d{4}/g);
  return years ? Math.max(...years.map(Number)) : 0;
}

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured && !p.data.draft)
  .sort((a, b) => projectSortKey(b.data.date) - projectSortKey(a.data.date));
const otherProjects = allProjects
  .filter(p => !p.data.featured && !p.data.draft)
  .sort((a, b) => projectSortKey(b.data.date) - projectSortKey(a.data.date));
---

<BaseLayout title="Projects — Albian Salihu" description="A selection of my work in robotics, embedded systems, and AI">
  <main class="projects-page">
    <div class="container">
      <header class="projects-header">
        <h1 class="page-title" data-i18n="proj.title" data-reveal>Projects</h1>
        <p class="page-subtitle glow-hover" data-i18n="proj.sub" data-reveal style="transition-delay:80ms">
          A selection of my work in robotics, embedded systems, and AI
        </p>
      </header>

      {featuredProjects.length > 0 && (
        <section class="featured-section">
          <h2 class="section-title" data-i18n="proj.feat">Featured Projects</h2>
          <div class="projects-grid featured-grid">
            {featuredProjects.map((project) => (
              <ProjectCard
                slug={project.id}
                title={project.data.title}
                description={project.data.description}
                tags={project.data.tags}
                featured={true}
                date={project.data.date}
                image={project.data.image}
                imageBg={project.data.imageBg}
                imagePosition={project.data.imagePosition}
                logoMode={project.data.logoMode}
              />
            ))}
          </div>
        </section>
      )}

      {otherProjects.length > 0 && (
        <section class="other-projects">
          <h2 class="section-title" data-i18n="proj.other">Other Projects</h2>
          <div class="projects-grid">
            {otherProjects.map((project) => (
              <ProjectCard
                slug={project.id}
                title={project.data.title}
                description={project.data.description}
                tags={project.data.tags}
                date={project.data.date}
                image={project.data.image}
                imageBg={project.data.imageBg}
                imagePosition={project.data.imagePosition}
                logoMode={project.data.logoMode}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .projects-page {
    min-height: 100vh;
    padding: calc(var(--nav-height) + 2rem) 2rem 5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    max-width: 500px;
    margin: 0 auto;
  }

  .featured-section,
  .other-projects {
    margin-bottom: 4rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--color-text-dim);
    letter-spacing: 0.02em;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .featured-grid {
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  }

  @media (max-width: 768px) {
    .projects-page {
      padding-top: calc(var(--nav-height) + 1rem);
    }

    .projects-grid,
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
