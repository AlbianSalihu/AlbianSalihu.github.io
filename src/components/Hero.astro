---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" id="hero-section">
  <div class="hero-content" id="hero-parallax">
    <div class="greeting" data-i18n="hero.greeting">Hello, I'm</div>
    <h1 class="hero-title">
      <span class="title-text">ALBIAN SALIHU</span>
    </h1>

    <!-- Typewriter subtitle -->
    <p class="hero-subtitle">
      <span id="typewriter-text"></span><span class="cursor-blink">|</span>
    </p>

    <p class="hero-description glow-hover" data-i18n="hero.desc">
      I design and build control systems for robotic and embedded applications —
      bridging hardware, software, and AI from prototype to real-world deployment.
    </p>
    <div class="hero-buttons">
      <a href={`${base}/projects`} class="btn btn-primary">
        <span data-i18n="hero.btn_proj">View Projects</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href={`${base}/about`} class="btn btn-secondary">
        <span data-i18n="hero.btn_about">About Me</span>
      </a>
    </div>

    <div class="tech-stack">
      <span class="tech-badge">Python</span>
      <span class="tech-badge">C/C++</span>
      <span class="tech-badge">ROS 2</span>
      <span class="tech-badge">FPGA</span>
      <span class="tech-badge">VHDL</span>
      <span class="tech-badge">ML</span>
    </div>
  </div>

  <div class="scroll-indicator" id="scroll-indicator">
    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: calc(var(--nav-height) + 2rem) 2rem 4rem;
  }

  .hero-content {
    text-align: center;
    z-index: 10;
    max-width: 800px;
    animation: fadeInUp 0.8s ease-out;
    will-change: transform;
  }

  .greeting {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 12vw, 7rem);
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .title-text {
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-primary) 50%, var(--color-accent-purple) 100%);
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientFlow 4s ease infinite;
  }

  @keyframes gradientFlow {
    0%, 100% { background-position: 0% 50%; }
    50%       { background-position: 100% 50%; }
  }

  .hero-subtitle {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-text);
    margin-bottom: 1.5rem;
    font-weight: 500;
    min-height: 2.2rem;
  }

  .cursor-blink {
    animation: blink 0.8s step-end infinite;
    color: var(--color-text-dim);
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  .hero-description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--color-text-dim);
    margin-bottom: 2.5rem;
    line-height: 1.7;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    font-family: var(--font-body);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: #f1f5f9;
    color: #0a0a0a;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }

  .btn-primary:hover {
    background: #ffffff;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
  }

  .btn-primary svg { transition: transform 0.2s ease; }
  .btn-primary:hover svg { transform: translateX(4px); }

  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--color-text-dim);
  }

  .tech-stack {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .tech-badge {
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    font-size: 0.875rem;
    color: var(--color-text-dim);
    transition: all 0.2s ease;
  }

  .tech-badge:hover {
    border-color: var(--color-text-dim);
    color: var(--color-text);
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-dim);
    opacity: 1;
    transition: opacity 0.4s ease;
    pointer-events: none;
    animation: scrollBounce 2s ease-in-out infinite;
    z-index: 10;
  }

  .scroll-indicator.hidden {
    opacity: 0;
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .title-text, .hero-content { animation: none; }
    .cursor-blink { animation: none; }
  }

  @media (max-width: 768px) {
    .hero { padding-top: calc(var(--nav-height) + 3rem); }
    .hero-buttons { flex-direction: column; align-items: center; }
    .btn { width: 100%; max-width: 280px; justify-content: center; }

    /* background-clip:text is unreliable on Android — use solid white instead */
    .title-text {
      background: none;
      -webkit-background-clip: unset;
      background-clip: unset;
      -webkit-text-fill-color: #f1f5f9;
      color: #f1f5f9;
      animation: none;
    }
  }
</style>

<script>
  // ── Typewriter cycling ──
  const phrasesEN = [
    'Robotics Engineer',
    'Embedded Systems',
    'FPGA Developer',
    'AI Integration',
    'Control Systems',
  ];
  const phrasesFR = [
    'Ingénieur en Robotique',
    'Systèmes Embarqués',
    'Développeur FPGA',
    'Intégration IA',
    'Systèmes de Contrôle',
  ];

  let phrases = phrasesEN;
  let phraseIdx = 0;
  let charIdx = 0;
  let deleting = false;
  let typeTimer: ReturnType<typeof setTimeout> | null = null;

  function typeStep() {
    const el = document.getElementById('typewriter-text');
    if (!el) return;

    const current = phrases[phraseIdx];

    if (!deleting) {
      el.textContent = current.slice(0, ++charIdx);
      if (charIdx === current.length) {
        deleting = true;
        typeTimer = setTimeout(typeStep, 1800);
        return;
      }
      typeTimer = setTimeout(typeStep, 60);
    } else {
      el.textContent = current.slice(0, --charIdx);
      if (charIdx === 0) {
        deleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        typeTimer = setTimeout(typeStep, 300);
        return;
      }
      typeTimer = setTimeout(typeStep, 35);
    }
  }

  function restartTypewriter(lang: string) {
    phrases = lang === 'fr' ? phrasesFR : phrasesEN;
    if (typeTimer) clearTimeout(typeTimer);
    phraseIdx = 0; charIdx = 0; deleting = false;
    typeStep();
  }

  document.addEventListener('astro:page-load', () => {
    const lang = localStorage.getItem('lang') || 'en';
    restartTypewriter(lang);
  });

  document.addEventListener('langchange', (e) => {
    restartTypewriter((e as CustomEvent).detail);
  });

  // ── Scroll indicator fade ──
  document.addEventListener('astro:page-load', () => {
    const indicator = document.getElementById('scroll-indicator');
    if (!indicator) return;
    const onScroll = () => {
      indicator.classList.toggle('hidden', window.scrollY > 60);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });

  // ── Star background fade on scroll (hero page only) ──
  document.addEventListener('astro:page-load', () => {
    const hero = document.getElementById('hero-section');
    const canvas = document.getElementById('constellation-canvas') as HTMLCanvasElement | null;
    if (!hero || !canvas) return;

    const onScroll = () => {
      const heroHeight = hero.offsetHeight;
      const progress = Math.min(window.scrollY / (heroHeight * 1.2), 1);
      canvas.style.opacity = String(1 - progress * 0.5);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  });
</script>
