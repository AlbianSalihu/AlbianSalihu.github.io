      function applyLanguage(lang: string) {
        localStorage.setItem('lang', lang);
        document.documentElement.lang = lang;
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n')!;
          if (T[key]?.[lang]) el.textContent = T[key][lang];
        });
        document.querySelectorAll<HTMLElement>('.lang-opt').forEach(opt => {
          opt.classList.toggle('active', opt.dataset.lang === lang);
        });
        // Notify components that language changed
        document.dispatchEvent(new CustomEvent('langchange', { detail: lang }));
        // Switch CV download to language-appropriate file and filename
        document.querySelectorAll<HTMLAnchorElement>('[data-cv-link]').forEach(a => {
          const base = a.href.replace(/\/cv(?:_fr)?\.pdf$/, '');
          if (lang === 'fr') {
            a.href = base + '/cv_fr.pdf';
            a.download = 'Albian_Salihu_CV_fr.pdf';
          } else {
            a.href = base + '/cv.pdf';
            a.download = 'Albian_Salihu_CV_en.pdf';
          }
        });
      }

      (window as any).__applyLanguage = applyLanguage;

      document.addEventListener('astro:page-load', () => {
        const lang = localStorage.getItem('lang') || 'en';
        applyLanguage(lang);
        document.querySelectorAll<HTMLElement>('.lang-opt').forEach(opt => {
          opt.addEventListener('click', () => applyLanguage(opt.dataset.lang!));
        });
      });

      // Page transition — instant hide on swap, brief stars-only pause, then fade in
      document.addEventListener('astro:after-swap', () => {
        const el = document.getElementById('page-content');
        if (!el) return;
        el.style.opacity = '0';
        el.animate(
          [{ opacity: 0 }, { opacity: 1 }],
          { duration: 450, delay: 180, easing: 'ease-out', fill: 'both' }
        );
      });
    </script>

    <script>
      // Scroll-reveal — runs after every page navigation
      function initReveal() {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('revealed');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach(el => {
          // Reset in case of View Transition re-use
          el.classList.remove('revealed');
          io.observe(el);
        });
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>

    <script is:inline>
      // KaTeX auto-render — loads lazily, re-runs on every Astro page transition
      let _katexLoaded = false;

      function _renderKatex() {
        if (_katexLoaded) {
          renderMathInElement(document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$',  right: '$',  display: false },
            ],
            throwOnError: false,
          });
          return;
        }
        const s1 = document.createElement('script');
        s1.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js';
        s1.crossOrigin = 'anonymous';
        s1.onload = () => {
          const s2 = document.createElement('script');
          s2.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js';
          s2.crossOrigin = 'anonymous';
          s2.onload = () => {
            _katexLoaded = true;
            renderMathInElement(document.body, {
              delimiters: [
                { left: '$$', right: '$$', display: true },
                { left: '$',  right: '$',  display: false },
              ],
              throwOnError: false,
            });
          };
          document.head.appendChild(s2);
        };
        document.head.appendChild(s1);
      }

      document.addEventListener('astro:page-load', _renderKatex);
    </script>

    <script>
      // Proximity glow — desktop only (pointer: fine = real mouse)
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        // dim text color components: #64748b = rgb(100, 116, 139)
        const DIM_R = 100, DIM_G = 116, DIM_B = 139;
        const RADIUS = 160; // px — how far the effect reaches

        let mouseX = -9999, mouseY = -9999;
        let rafQueued = false;
        let glowEls: HTMLElement[] = [];

        function refreshElements() {
          glowEls = Array.from(document.querySelectorAll<HTMLElement>('.glow-hover'));
        }

        function update() {
          rafQueued = false;
          for (const el of glowEls) {
            const r = el.getBoundingClientRect();
            const dx = Math.max(r.left - mouseX, 0, mouseX - r.right);
            const dy = Math.max(r.top  - mouseY, 0, mouseY - r.bottom);
            const dist = Math.sqrt(dx * dx + dy * dy);
            const t = Math.max(0, 1 - dist / RADIUS);

            if (t > 0) {
              const cr = Math.round(DIM_R + t * (255 - DIM_R));
              const cg = Math.round(DIM_G + t * (255 - DIM_G));
              const cb = Math.round(DIM_B + t * (255 - DIM_B));
              el.style.color      = `rgb(${cr},${cg},${cb})`;
              if (!el.classList.contains('glow-hover-nobg'))
                el.style.background = `rgba(0,0,0,${(t * 0.35).toFixed(2)})`;
            } else {
              el.style.color      = '';
              el.style.background = '';
            }
          }
        }

        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          if (!rafQueued) { rafQueued = true; requestAnimationFrame(update); }
        });

        // Reset when mouse leaves the window
        document.addEventListener('mouseleave', () => {
          mouseX = mouseY = -9999;
          if (!rafQueued) { rafQueued = true; requestAnimationFrame(update); }
        });

        document.addEventListener('astro:page-load', refreshElements);
      }

      // ── Back to top ──
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        window.addEventListener('scroll', () => {
          btn.classList.toggle('visible', window.scrollY > 400);
        }, { passive: true });
        btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      });
    </script>
  </body>
</html>
