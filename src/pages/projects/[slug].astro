---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Only h2 and h3 for the sidebar
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// YouTube embed helper
const ytMatch = project.data.video?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s]+)/);
const youtubeId = ytMatch?.[1] ?? null;
---

<BaseLayout title={`${project.data.title} — Albian Salihu`} description={project.data.description}>
  <div class="project-layout">

    <!-- Sidebar TOC -->
    <aside class="toc-sidebar" id="toc-sidebar">
      <nav class="toc-nav">
        <a href={`${base}/projects`} class="toc-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span data-i18n="toc.back">All Projects</span>
        </a>
        <div class="toc-divider"></div>
        <p class="toc-label" data-i18n="toc.onpage">On this page</p>
        <ul class="toc-list">
          {tocHeadings.map(h => (
            <li class:list={['toc-item', `toc-h${h.depth}`]}>
              <a href={`#${h.slug}`} class="toc-link" data-heading={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <!-- Main content -->
    <main class="project-main">
      <!-- Header -->
      <header class="project-header">
        <div class="project-meta">
          {project.data.date && <span class="project-date">{project.data.date}</span>}
          {project.data.featured && <span class="featured-badge" data-i18n="proj.feat_badge">Featured</span>}
        </div>
        <h1 class="project-title" data-i18n={`p.${project.id}.t`}>{project.data.title}</h1>
        <p class="project-description glow-hover glow-hover-nobg" data-i18n={`p.${project.id}.d`}>{project.data.description}</p>

        {project.data.tags && project.data.tags.length > 0 && (
          <div class="project-tags">
            {project.data.tags.map(tag => (
              <span class="tag glow-hover glow-hover-nobg">{tag}</span>
            ))}
          </div>
        )}

        <!-- Links bar -->
        <div class="project-links">
          {project.data.github && (
            <a href={project.data.github} class="project-link glow-hover glow-hover-nobg" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
              GitHub
            </a>
          )}
          {project.data.link && (
            <a href={project.data.link} class="project-link glow-hover glow-hover-nobg" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              Live Demo
            </a>
          )}
          {project.data.report && (
            <a href={project.data.report.startsWith('http') ? project.data.report : `${base}${project.data.report}`} class="project-link project-link--report glow-hover glow-hover-nobg" download>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span data-i18n="proj.report">Download Report</span>
            </a>
          )}
        </div>
      </header>

      <!-- Media: images from frontmatter -->
      {project.data.images && project.data.images.length > 0 && (
        <div class:list={['project-gallery', project.data.images.length === 1 ? 'single' : '']}>
          {project.data.images.map(src => (
            <img src={`${base}/${src}`} alt="" loading="lazy" />
          ))}
        </div>
      )}

      <!-- Media: video from frontmatter -->
      {project.data.video && (
        <div class="project-video">
          {youtubeId ? (
            <iframe
              src={`https://www.youtube.com/embed/${youtubeId}`}
              title="Project video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          ) : (
            <video src={project.data.video.startsWith('http') ? project.data.video : `${base}${project.data.video}`} controls></video>
          )}
        </div>
      )}

      <!-- Markdown body -->
      <article class="project-body" data-base={base}>
        <Content />
      </article>

      <!-- Footer nav -->
      <div class="project-footer">
        <a href={`${base}/projects`} class="btn-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span data-i18n="toc.back">All Projects</span>
        </a>
      </div>
    </main>

  </div>
</BaseLayout>

<style>
  .project-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    max-width: 1200px;
    margin: 0 auto;
    padding-top: calc(var(--nav-height, 80px) + 2rem);
    padding-bottom: 5rem;
    gap: 3rem;
    padding-left: 2.5rem;
    padding-right: 2.5rem;
    min-height: 100vh;
    /* Dark pane only around the text content */
    background: rgba(4, 4, 12, 0.70);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    border-radius: 0 0 1rem 1rem;
  }

  /* ── Sidebar ── */
  .toc-sidebar {
    position: sticky;
    top: calc(var(--nav-height, 80px) + 2rem);
    align-self: start;
    max-height: calc(100vh - var(--nav-height, 80px) - 4rem);
    overflow-y: auto;
    scrollbar-width: none;
  }

  .toc-sidebar::-webkit-scrollbar { display: none; }

  .toc-nav {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  .toc-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color 0.2s ease;
    margin-bottom: 0.75rem;
  }

  .toc-back:hover { color: var(--color-text); }

  .toc-divider {
    height: 1px;
    background: var(--color-border);
    margin: 0.75rem 0;
  }

  .toc-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 0.75rem;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .toc-item { padding: 0; }

  .toc-h3 { padding-left: 0.75rem; }

  .toc-link {
    display: block;
    padding: 0.3rem 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-dim);
    text-decoration: none;
    border-radius: 0.375rem;
    border-left: 2px solid transparent;
    transition: all 0.15s ease;
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--color-text);
    background: rgba(255,255,255,0.04);
  }

  .toc-link.active {
    color: var(--color-text);
    border-left-color: var(--color-text);
    background: rgba(255,255,255,0.05);
  }

  /* ── Main ── */
  .project-main {
    min-width: 0;
  }

  .project-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .project-date {
    font-size: 0.8rem;
    color: var(--color-text-dim);
    font-family: var(--font-heading);
    letter-spacing: 0.03em;
  }

  .featured-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(255,255,255,0.07);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .project-description {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    line-height: 1.7;
    margin-bottom: 1.25rem;
    max-width: 700px;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    padding: 0.25rem 0.625rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-dim);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .project-link:hover {
    color: var(--color-text);
    border-color: #2a2a2a;
    background: rgba(255,255,255,0.03);
  }

  .project-link--report {
    border-color: rgba(255,255,255,0.12);
  }

  /* ── Media gallery ── */
  .project-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .project-gallery.single {
    grid-template-columns: 1fr;
  }

  .project-gallery img {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    object-fit: cover;
    max-height: 420px;
  }

  .project-video {
    margin-bottom: 2.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .project-video iframe,
  .project-video video {
    width: 100%;
    height: 100%;
    display: block;
    border: none;
  }

  /* ── Markdown body ── */
  .project-body {
    line-height: 1.75;
    color: rgba(241, 245, 249, 0.78);
  }

  .project-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 3rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .project-body :global(h2:first-child) {
    border-top: none;
    margin-top: 0;
  }

  .project-body :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 2rem 0 0.75rem;
  }

  .project-body :global(p) {
    margin-bottom: 1.25rem;
    max-width: 720px;
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .project-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .project-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .project-body :global(th),
  .project-body :global(td) {
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .project-body :global(th) {
    background: rgba(255,255,255,0.03);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-body :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-dim);
    font-style: italic;
  }

  .project-body :global(code) {
    background: rgba(255,255,255,0.06);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
    color: var(--color-text);
  }

  .project-body :global(pre) {
    background: #0e0e0e;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .project-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .project-body :global(video) {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    margin: 1.5rem 0;
    background: #000;
    display: block;
    max-height: 520px;
  }

  /* Side-by-side video grid */
  .project-body :global(.video-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin: 1rem 0 1.5rem;
  }

  .project-body :global(.video-grid video) {
    margin: 0;
    max-height: none;
    border-radius: 0.375rem;
  }

  .project-body :global(.video-label) {
    font-size: 0.72rem;
    color: var(--color-text-dim);
    text-align: center;
    margin-top: 0.2rem;
    display: block;
  }

  @media (max-width: 640px) {
    .project-body :global(.video-grid) {
      grid-template-columns: 1fr;
    }
  }

  /* Image placeholders — any img that fails to load gets a styled placeholder look */
  .project-body :global(img) {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    margin: 1.5rem 0;
    background: var(--color-bg-card);
  }

  /* ── Inline button (usable inside markdown body) ── */
  .project-body :global(.project-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-dim);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    text-decoration: none;
    margin: 0.5rem 0 1rem;
    transition: all 0.2s ease;
  }

  .project-body :global(.project-btn:hover) {
    color: var(--color-text);
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.2);
  }

  /* ── Footer ── */
  .project-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-dim);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-back:hover {
    color: var(--color-text);
    border-color: #2a2a2a;
    background: rgba(255,255,255,0.03);
  }

  /* ── Lightbox ── */
  :global(.lightbox-overlay) {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    animation: lbFadeIn 0.18s ease;
  }
  @keyframes lbFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  :global(.lightbox-overlay img) {
    max-width: 90vw;
    max-height: 90vh;
    width: auto !important;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
    margin: 0 !important;
    border: none !important;
    cursor: zoom-out;
  }
  .project-body :global(img[data-lightbox]) {
    cursor: zoom-in;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .project-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .toc-sidebar {
      position: static;
      max-height: none;
    }

    .toc-nav {
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 640px) {
    .project-layout {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>

<script>
  // Lightbox — any img[data-lightbox] opens a full-screen overlay on click
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLImageElement>('img[data-lightbox]').forEach(img => {
      img.addEventListener('click', () => {
        const overlay = document.createElement('div');
        overlay.className = 'lightbox-overlay';
        const big = document.createElement('img');
        big.src = img.src;
        big.alt = img.alt;
        if (img.style.background) big.style.background = img.style.background;
        overlay.appendChild(big);
        document.body.appendChild(overlay);

        const close = () => overlay.remove();
        overlay.addEventListener('click', close);
        const onKey = (e: KeyboardEvent) => {
          if (e.key === 'Escape') { close(); document.removeEventListener('keydown', onKey); }
        };
        document.addEventListener('keydown', onKey);
      });
    });
  });
</script>

<script>
  // Fix local asset paths in markdown body — prepend BASE_URL stored in data-base attribute
  document.addEventListener('astro:page-load', () => {
    const body = document.querySelector<HTMLElement>('.project-body');
    if (!body) return;
    const base = body.dataset.base ?? '';
    if (!base) return;
    body.querySelectorAll<HTMLVideoElement | HTMLImageElement>('video[src], img[src]').forEach(el => {
      const src = el.getAttribute('src')!;
      if (src.startsWith('/') && !src.startsWith(base)) {
        el.setAttribute('src', base + src);
      }
    });
  });
</script>

<script>
  // Scroll spy — highlight active heading in TOC
  document.addEventListener('astro:page-load', () => {
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link[data-heading]');
    if (!links.length) return;

    const headingIds = Array.from(links).map(l => l.dataset.heading!);
    const headingEls = headingIds
      .map(id => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    let activeId = '';

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            activeId = entry.target.id;
          }
        });
        links.forEach(link => {
          link.classList.toggle('active', link.dataset.heading === activeId);
        });
      },
      {
        rootMargin: '-80px 0px -60% 0px',
        threshold: 0,
      }
    );

    headingEls.forEach(el => observer.observe(el));

    // Smooth scroll on TOC click
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const id = link.dataset.heading!;
        const target = document.getElementById(id);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>
