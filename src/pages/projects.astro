---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

function projectSortKey(date: string | undefined): number {
  if (!date) return 0;
  if (/Present/i.test(date)) return 9999;
  const years = date.match(/\d{4}/g);
  return years ? Math.max(...years.map(Number)) : 0;
}

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured && !p.data.draft)
  .sort((a, b) => projectSortKey(b.data.date) - projectSortKey(a.data.date));
const otherProjects = allProjects
  .filter(p => !p.data.featured && !p.data.draft)
  .sort((a, b) => projectSortKey(b.data.date) - projectSortKey(a.data.date));

const filters = [
  { en: 'All',           fr: 'Tous',               match: [] },
  { en: 'FPGA',          fr: 'FPGA',               match: ['FPGA', 'VHDL'] },
  { en: 'Robotics',      fr: 'Robotique',           match: ['Robotics', 'ROS 2'] },
  { en: 'Deep Learning', fr: 'Deep Learning',       match: ['Deep Learning', 'Reinforcement Learning', 'ML'] },
  { en: 'Embedded',      fr: 'Embarqué',            match: ['Embedded', 'Embedded Systems'] },
  { en: 'Space',         fr: 'Spatial',             match: ['Space'] },
];
---

<BaseLayout title="Projects — Albian Salihu" description="A selection of my work in robotics, embedded systems, and AI">
  <main class="projects-page">
    <div class="container">
      <header class="projects-header">
        <h1 class="page-title" data-i18n="proj.title" data-reveal>Projects</h1>
        <p class="page-subtitle glow-hover" data-i18n="proj.sub" data-reveal style="transition-delay:80ms">
          A selection of my work in robotics, embedded systems, and AI
        </p>
      </header>

      <div class="filter-bar" data-reveal style="transition-delay:120ms">
        {filters.map((f, i) => (
          <button
            class:list={['filter-pill', { active: i === 0 }]}
            data-filter={JSON.stringify(f.match)}
          >
            <span class="lang-en">{f.en}</span>
            <span class="lang-fr">{f.fr}</span>
          </button>
        ))}
      </div>

      <div class="projects-grid" id="projects-grid">
        <!-- Featured heading -->
        <div class="grid-heading" id="heading-featured" data-i18n="proj.feat">Featured Projects</div>

        {featuredProjects.map((project) => (
          <div class="card-wrapper" data-tags={JSON.stringify(project.data.tags ?? [])} data-group="featured">
            <ProjectCard
              slug={project.id}
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              featured={true}
              date={project.data.date}
              image={project.data.image}
              imageBg={project.data.imageBg}
              imagePosition={project.data.imagePosition}
              logoMode={project.data.logoMode}
            />
          </div>
        ))}

        <!-- Other heading -->
        <div class="grid-heading" id="heading-other" data-i18n="proj.other">Other Projects</div>

        {otherProjects.map((project) => (
          <div class="card-wrapper" data-tags={JSON.stringify(project.data.tags ?? [])} data-group="other">
            <ProjectCard
              slug={project.id}
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              date={project.data.date}
              image={project.data.image}
              imageBg={project.data.imageBg}
              imagePosition={project.data.imagePosition}
              logoMode={project.data.logoMode}
            />
          </div>
        ))}
      </div>

      <p class="no-results" id="no-results" style="display:none">No projects match this filter.</p>
    </div>
  </main>
</BaseLayout>

<style>
  .projects-page {
    min-height: 100vh;
    padding: calc(var(--nav-height) + 2rem) 2rem 5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    max-width: 500px;
    margin: 0 auto;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .filter-pill {
    padding: 0.4rem 1rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-dim);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover {
    color: var(--color-text);
    border-color: var(--color-text-dim);
  }

  .filter-pill.active {
    background: rgba(255,255,255,0.1);
    border-color: var(--color-text-dim);
    color: var(--color-text);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .grid-heading {
    grid-column: 1 / -1;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-dim);
    letter-spacing: 0.02em;
    padding-top: 1rem;
  }

  .grid-heading:first-child {
    padding-top: 0;
  }

  .grid-heading.hidden {
    display: none;
  }

  .card-wrapper {
    display: flex;
    flex-direction: column;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .card-wrapper.hidden {
    display: none;
  }

  .card-wrapper.exit {
    opacity: 0;
    transform: scale(0.9) translateY(-6px);
    pointer-events: none;
  }

  .card-wrapper.enter {
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
  }

  .no-results {
    text-align: center;
    color: var(--color-text-dim);
    font-size: 1rem;
    padding: 3rem 0;
  }

  @media (max-width: 768px) {
    .projects-page {
      padding-top: calc(var(--nav-height) + 1rem);
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const wrappers = Array.from(document.querySelectorAll<HTMLElement>('.card-wrapper'));
    const headingFeatured = document.getElementById('heading-featured');
    const headingOther = document.getElementById('heading-other');
    const noResults = document.getElementById('no-results');
    const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));
    let animating = false;

    pills.forEach(pill => {
      pill.addEventListener('click', async () => {
        if (animating) return;
        animating = true;

        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        const match: string[] = JSON.parse(pill.dataset.filter || '[]');
        const isAll = match.length === 0;

        // Categorise
        const visible = wrappers.filter(w => !w.classList.contains('hidden'));
        const next = wrappers.filter(w => {
          const tags: string[] = JSON.parse(w.dataset.tags || '[]');
          return isAll || match.some(m => tags.includes(m));
        });
        const toHide = visible.filter(w => !next.includes(w));
        const toShow = next.filter(w => !visible.includes(w));

        // Step 1: exit all visible cards simultaneously
        visible.forEach(w => w.classList.add('exit'));

        await sleep(200);

        // Step 2: apply layout while everything is invisible
        toHide.forEach(w => { w.classList.remove('exit'); w.classList.add('hidden'); });
        toShow.forEach(w => { w.classList.remove('hidden'); w.classList.add('enter'); });
        // keep staying cards invisible for stagger
        const staying = next.filter(w => visible.includes(w));
        staying.forEach(w => { w.classList.remove('exit'); w.classList.add('enter'); });

        headingFeatured?.classList.toggle('hidden', !isAll);
        headingOther?.classList.toggle('hidden', !isAll);

        const totalVisible = next.length;
        if (noResults) noResults.style.display = totalVisible === 0 ? 'block' : 'none';

        // Step 3: staggered entrance
        await sleep(16);
        next.forEach((w, i) => {
          setTimeout(() => w.classList.remove('enter'), i * 40);
        });

        setTimeout(() => { animating = false; }, 200 + next.length * 40);
      });
    });
  });
</script>
