---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Contact — Albian Salihu" description="Robotics Engineer based in Lausanne, Switzerland">
  <main class="about-page">
    <div class="container">
      <h1 class="page-title" data-i18n="about.title" data-reveal>Contact</h1>

      <div class="content-grid">

        <!-- Currently -->
        <section class="content-section currently-section" data-reveal style="transition-delay:80ms">
          <div class="currently-header">
            <span class="currently-label" data-i18n="about.currently">Currently</span>
            <span class="open-badge" data-i18n="about.open">Open to new opportunities</span>
          </div>
          <div class="currently-role">
            <span class="role-title" data-i18n="about.role">Robotics and Systems Integration Engineer</span>
            <span class="role-at" data-i18n="about.at">at Wasteflow, Lausanne</span>
          </div>
          <p class="glow-hover glow-hover-nobg currently-desc" data-i18n="about.curr_desc">
            Developing real-time control systems for industrial waste-sorting conveyors — bridging AI vision decisions with precise physical actuation.
          </p>
        </section>

        <!-- Contact form -->
        <section class="content-section" data-reveal style="transition-delay:160ms">
          <h2 data-i18n="about.contact">Get in Touch</h2>
          <p class="form-subtitle glow-hover glow-hover-nobg" data-i18n="about.contact_sub">
            Working on a robotics, embedded, or systems integration challenge? Tell me about the role, project, or problem.
          </p>

          <div id="form-success" class="form-success" style="display:none">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span data-i18n="about.f_success">Thanks! I'll get back to you soon.</span>
          </div>

          <form id="contact-form" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="cf-name" data-i18n="about.f_name">Name</label>
                <input type="text" id="cf-name" name="name" autocomplete="name" />
                <span class="field-error" id="err-name"></span>
              </div>
              <div class="form-group">
                <label for="cf-email" data-i18n="about.f_email">Email</label>
                <input type="email" id="cf-email" name="email" autocomplete="email" />
                <span class="field-error" id="err-email"></span>
              </div>
            </div>
            <div class="form-group">
              <label for="cf-message" data-i18n="about.f_msg">Message</label>
              <textarea id="cf-message" name="message" rows="5"></textarea>
              <span class="field-error" id="err-message"></span>
            </div>
            <div class="form-footer">
              <span class="form-error" id="form-error" style="display:none" data-i18n="about.f_error">Something went wrong. Please try again.</span>
              <button type="submit" id="form-submit" class="btn-send">
                <span id="btn-label" data-i18n="about.f_send">Send</span>
                <svg id="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>
          </form>
        </section>

      </div>
    </div>
  </main>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const nameEl    = document.getElementById('cf-name')     as HTMLInputElement;
    const emailEl   = document.getElementById('cf-email')    as HTMLInputElement;
    const messageEl = document.getElementById('cf-message')  as HTMLTextAreaElement;
    const submitBtn = document.getElementById('form-submit') as HTMLButtonElement;
    const btnLabel  = document.getElementById('btn-label')   as HTMLSpanElement;
    const successEl = document.getElementById('form-success') as HTMLElement;
    const formError = document.getElementById('form-error')  as HTMLElement;
    const errName   = document.getElementById('err-name')    as HTMLSpanElement;
    const errEmail  = document.getElementById('err-email')   as HTMLSpanElement;
    const errMsg    = document.getElementById('err-message') as HTMLSpanElement;

    const lang = () => localStorage.getItem('lang') || 'en';

    const validate = () => {
      let ok = true;
      errName.textContent = '';
      errEmail.textContent = '';
      errMsg.textContent = '';
      nameEl.classList.remove('invalid');
      emailEl.classList.remove('invalid');
      messageEl.classList.remove('invalid');

      if (!nameEl.value.trim()) {
        errName.textContent = lang() === 'fr' ? 'Requis' : 'Required';
        nameEl.classList.add('invalid');
        ok = false;
      }
      if (!emailEl.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value)) {
        errEmail.textContent = lang() === 'fr' ? 'Email invalide' : 'Invalid email';
        emailEl.classList.add('invalid');
        ok = false;
      }
      if (!messageEl.value.trim()) {
        errMsg.textContent = lang() === 'fr' ? 'Requis' : 'Required';
        messageEl.classList.add('invalid');
        ok = false;
      }
      return ok;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.style.display = 'none';
      if (!validate()) return;

      submitBtn.disabled = true;
      btnLabel.setAttribute('data-i18n', 'about.f_sending');
      btnLabel.textContent = lang() === 'fr' ? 'Envoi…' : 'Sending…';

      try {
        const res = await fetch('https://formspree.io/f/mrerqnoy', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(form),
        });

        if (res.ok) {
          form.style.display = 'none';
          successEl.style.display = 'flex';
        } else {
          throw new Error();
        }
      } catch {
        formError.style.display = 'block';
        submitBtn.disabled = false;
        btnLabel.setAttribute('data-i18n', 'about.f_send');
        btnLabel.textContent = lang() === 'fr' ? 'Envoyer' : 'Send';
      }
    });
  });
</script>

<style>
  .about-page {
    min-height: 100vh;
    padding: calc(var(--nav-height) + 2rem) 2rem 5rem;
  }

  .container {
    max-width: 740px;
    margin: 0 auto;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-text);
  }

  .content-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .content-section {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem;
  }

  .content-section h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .content-section p {
    line-height: 1.7;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }

  .content-section p:last-of-type {
    margin-bottom: 0;
  }

  /* ── Currently ── */
  .currently-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .currently-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .currently-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .open-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.7rem;
    background: rgba(100, 216, 150, 0.08);
    border: 1px solid rgba(100, 216, 150, 0.25);
    border-radius: 2rem;
    font-size: 0.72rem;
    font-family: var(--font-heading);
    font-weight: 500;
    color: #6ddf9a;
  }

  .open-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6ddf9a;
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  .currently-role {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .role-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .role-at {
    font-size: 0.9rem;
    color: var(--color-text-dim);
    font-family: var(--font-heading);
  }

  .currently-desc {
    color: var(--color-text-dim);
    line-height: 1.7;
    margin: 0;
  }

  .form-subtitle {
    color: var(--color-text-dim);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  #contact-form {
    margin-top: 2rem;
  }

  /* Hide browser autofill icon */
  input::-webkit-contacts-auto-fill-button,
  input::-webkit-credentials-auto-fill-button {
    visibility: hidden;
    pointer-events: none;
  }

  /* ── Form ── */
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1.1rem;
  }

  .form-group label {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .form-group input,
  .form-group textarea {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.7rem 1rem;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
    resize: none;
    width: 100%;
    box-sizing: border-box;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: transparent;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.06);
  }

  .form-group input.invalid,
  .form-group textarea.invalid {
    border-color: #f87171;
  }

  .field-error {
    font-size: 0.75rem;
    color: #f87171;
    min-height: 1rem;
  }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .form-error {
    font-size: 0.85rem;
    color: #f87171;
  }

  .btn-send {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    background: #f1f5f9;
    color: #0a0a0a;
    border: none;
    border-radius: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
  }

  .btn-send:hover {
    background: #ffffff;
  }

  .btn-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-send svg {
    transition: transform 0.2s ease;
  }

  .btn-send:hover:not(:disabled) svg {
    transform: translateX(3px);
  }

  /* Success */
  .form-success {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(100, 216, 150, 0.08);
    border: 1px solid rgba(100, 216, 150, 0.25);
    border-radius: 0.5rem;
    color: #6ddf9a;
    font-size: 0.95rem;
  }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
    .about-page { padding-top: calc(var(--nav-height) + 1rem); }
  }
</style>
