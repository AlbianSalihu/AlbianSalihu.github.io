---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function projectSortKey(date: string | undefined): number {
  if (!date) return 0;
  if (/Present/i.test(date)) return 9999;
  const years = date.match(/\d{4}/g);
  return years ? Math.max(...years.map(Number)) : 0;
}

const allProjects = await getCollection('projects');
const projects = allProjects
  .filter(p => p.data.featured && !p.data.draft)
  .sort((a, b) => projectSortKey(b.data.date) - projectSortKey(a.data.date));
---

<section class="featured-projects">
  <div class="container">
    <h2 class="section-title" data-reveal>
      <span class="lang-en">Selected Projects</span>
      <span class="lang-fr">Sélection de projets</span>
    </h2>

    <div class="project-list">
      {projects.map((p, i) => (
        <a href={`${base}/projects/${p.id}`} class="project-row" data-reveal style={`transition-delay:${i * 60}ms`}>
          <div class="project-row-left">
            <span class="project-number">0{i + 1}</span>
            <span class="project-name">{p.data.title}</span>
          </div>
          <div class="project-row-right">
            <div class="project-tags">
              {p.data.tags?.slice(0, 3).map((tag: string) => <span class="tag">{tag}</span>)}
            </div>
            <svg class="arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="view-all" data-reveal style={`transition-delay:${projects.length * 60 + 60}ms`}>
      <a href={`${base}/projects`} class="view-all-link">
        <span class="lang-en">View all projects</span>
        <span class="lang-fr">Voir tous les projets</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .featured-projects {
    padding: 6rem 2rem;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-text);
    text-align: center;
    margin-bottom: 3rem;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .project-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
  }

  .project-row:hover .project-name {
    color: var(--color-text);
  }

  .project-row:hover .arrow {
    transform: translateX(4px);
    color: var(--color-text);
  }

  .project-row-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
  }

  .project-number {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    color: var(--color-text-dim);
    opacity: 0.4;
    flex-shrink: 0;
  }

  .project-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text-dim);
    transition: color 0.2s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .project-row-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .project-tags {
    display: flex;
    gap: 0.4rem;
  }

  .tag {
    padding: 0.2rem 0.55rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font-size: 0.72rem;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .arrow {
    color: var(--color-text-dim);
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .view-all {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, gap 0.2s ease;
  }

  .view-all-link svg {
    animation: nudge 1.4s ease-in-out infinite;
  }

  @keyframes nudge {
    0%, 100% { transform: translateX(0); }
    50%       { transform: translateX(5px); }
  }

  .view-all-link:hover {
    background: rgba(255,255,255,0.1);
    border-color: var(--color-text-dim);
    gap: 0.7rem;
  }

  @media (max-width: 640px) {
    .project-tags { display: none; }
    .project-name { font-size: 0.95rem; }
  }
</style>
